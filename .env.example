# Server-only OpenRouter credential. Never prefix this with NEXT_PUBLIC_ or commit a real key.
OPENROUTER_API_KEY=replace-with-a-rotated-openrouter-api-key

# Sign and verify HttpOnly session cookies (at least 32 characters; generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Staff account is seeded on first database initialization.
STAFF_ADMIN_EMAIL=techmakers077@gmail.com
STAFF_ADMIN_PASSWORD=replace-with-the-private-staff-password

# Public payment instructions shown in the UI.
NEXT_PUBLIC_GPAY_NUMBER=9500089956

# Local development uses a JSON file. Set WEBBOOKS_STORAGE=netlify-blobs in Netlify's UI.
WEBBOOKS_STORAGE=file
